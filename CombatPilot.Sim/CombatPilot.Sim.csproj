<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline rotation simulator: Combat Pilot's own planner (the same source files, linked) run
    against a modelled fight. Used by CI to check every job file against expectations, and to tune
    per-fight profiles from a fight timeline. No Dalamud, no game: action data comes from
    actions.json (tools/sim/build_action_data.py, from the public game data).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CombatPilot.Sim</RootNamespace>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../CombatPilot/Enums.cs" Link="Core/Enums.cs" />
    <Compile Include="../CombatPilot/Engine/EngineLog.cs" Link="Core/EngineLog.cs" />
    <Compile Include="../CombatPilot/Engine/Sim.cs" Link="Core/Sim.cs" />
    <Compile Include="../CombatPilot/Engine/Planner.cs" Link="Core/Planner.cs" />
    <Compile Include="../CombatPilot/Engine/GameState.cs" Link="Core/GameState.cs" />
    <Compile Include="../CombatPilot/Engine/PositionInfo.cs" Link="Core/PositionInfo.cs" />
    <Compile Include="../CombatPilot/Jobs/JobDef.cs" Link="Core/JobDef.cs" />
    <Compile Include="../CombatPilot/Jobs/JobBinding.cs" Link="Core/JobBinding.cs" />
  </ItemGroup>
</Project>
